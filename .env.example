# Firebase web config (public values — required in Vercel Production + Preview)
# Add the same keys in Vercel → Project → Settings → Environment Variables
# IMPORTANT: paste values WITHOUT wrapping quotes ("..."). Quotes break Firestore.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Optional aliases also supported by the server:
# NUXT_PUBLIC_FIREBASE_API_KEY=
# NUXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
# NUXT_PUBLIC_FIREBASE_PROJECT_ID=
# NUXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
# NUXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
# NUXT_PUBLIC_FIREBASE_APP_ID=

# YouTube API (optional — homepage video archive)
VITE_YOUTUBE_API_KEY=
VITE_YOUTUBE_CHANNEL_ID=

# Contact inbox override (optional)
# CONTACT_INBOX=info.accurateblack@gmail.com
